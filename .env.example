# .env.example — copy to .env and fill in. Never commit .env.
AWS_PROFILE=aws-secondary-account
AWS_REGION=ap-south-1
# Deployed processes read secrets at start (never baked into images or templates):
# DB_SECRET_ARN  = the RDS-generated secret (JSON username/password/host/port/dbname) -> DATABASE_URL
# APP_SECRET_ARN = muxaris/app (JSON key->value: SARVAM_TTS_API_KEY, RAZORPAY_*, WHATSAPP_TOKEN ...)
DB_SECRET_ARN=
APP_SECRET_ARN=
DATABASE_URL=postgres://muxaris:muxaris@localhost:5433/muxaris
# Postgres SSL: unset for local Docker. Deployed processes use "verify" (chain checked against the
# embedded RDS global CA bundle; DATABASE_SSL_CA=/path overrides it). "no-verify" is for debugging only.
DATABASE_SSL=
DATABASE_SSL_CA=
# Production on AWS (the stacks set it; leave unset locally). Turns on production checks (no AUTH_MODE=dev, no mock voice).
# NODE_ENV=production
# Git short sha of the images pushed to ECR (scripts/push-images.sh prints it); read when deploying MuxarisServices.
IMAGE_TAG=
# ACM certificate ARN (scripts/request-cert.sh prints it). Set when deploying MuxarisServices to add HTTPS;
# if it is empty the ALB serves plain HTTP only, so keep it set on every services deploy.
CERT_ARN=
# Email that receives CloudWatch alarms through SNS (confirm the subscription once); read by MuxarisObservability.
ALARM_EMAIL=

# Sarvam AI (one key serves STT, TTS and chat)
SARVAM_TTS_API_KEY=
# Voice gateway provider: sarvam, or mock for offline tests. Empty picks sarvam when the key is set.
# mock is refused when NODE_ENV=production (the deployed task sets VOICE_PROVIDER=sarvam).
VOICE_PROVIDER=

# Azure OpenAI gpt-image-2 (asset generation only)
GPT_IMAGE_ENDPOINT=
GPT_IMAGE_API_KEY=

# Bedrock model for the voice LLM. Amazon Nova only (no Anthropic models). Note the global.
# prefix may process traffic outside India; apac.amazon.nova-lite-v1:0 is the regional fallback.
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Cognito (printed by scripts/bootstrap-aws.sh after the Auth stack deploys)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Optional: Google federation for Cognito
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Local URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:4100
API_PORT=4000
VOICE_PORT=4100

# API: comma-separated allowed browser origins (default: localhost:3000 and muxaris.com)
CORS_ORIGINS=http://localhost:3000
# Build/commit id reported by /healthz (set by CI; "dev" when empty)
# GIT_SHA=
# Voice gateway (/v1/session). Auth uses AUTH_MODE / COGNITO_* below (the first WebSocket frame
# carries the token; never the URL). CORS_ORIGINS above is also the WebSocket Origin allow-list.
# MAX_SESSIONS: global concurrent call sessions per instance (keep below Sarvam's limit of 20).
# MAX_CALL_SECONDS: hard cap for a single call, default 1200 = 20 min.
MAX_SESSIONS=15
MAX_CALL_SECONDS=1200

# API auth. Default is cognito: it verifies Cognito access tokens using COGNITO_USER_POOL_ID /
# COGNITO_CLIENT_ID above. AUTH_MODE=dev accepts "Bearer dev:<sub>:<email>" tokens for local
# development only (refused when NODE_ENV=production); tests and scripts set AUTH_MODE=dev
# themselves, so you do not need it here.
AUTH_MODE=cognito

# Show "Continue with Google" on web auth pages (needs the Google IdP configured in Cognito).
NEXT_PUBLIC_GOOGLE_ENABLED=0

# API: how to identify callers for the public demo-request rate limit (5/hour per IP).
# 0 = use the socket address (default, local dev). Set 1 behind the ALB to use the last
# X-Forwarded-For hop; never set 1 when the API is directly reachable.
TRUST_PROXY=0

# S3 bucket for call recordings and transcripts (CDK stack MuxarisStorage output CallsBucketName).
CALLS_BUCKET=
# SQS queue URL for post-call processing jobs (MuxarisStorage output PostCallQueueUrl).
POST_CALL_QUEUE_URL=
# Bedrock model for the post-call worker (Amazon Nova only).
POST_CALL_MODEL_ID=apac.amazon.nova-pro-v1:0
# 1 skips recording upload and queueing entirely (tests and CI); empty = storage enabled.
# The voice gateway also needs CALLS_BUCKET to record: with it empty nothing is recorded, uploaded
# or queued, and the call disclosure stays transcription-only. Clinics can opt out with
# settings.recordCalls = false (transcript still uploaded).
STORAGE_DISABLED=

# Notifications. NOTIFY_PROVIDER: console (default when NOTIFY_FROM_EMAIL is unset; logs counts
# only, the outbox UI shows the messages) or aws (alias ses; default when NOTIFY_FROM_EMAIL is set).
# Set NOTIFY_FROM_EMAIL to a verified SES sender (MuxarisNotify stack + DNS) to send real email.
NOTIFY_PROVIDER=
NOTIFY_FROM_EMAIL=
# 1 enables SMS via SNS (needs TRAI DLT registration and SNS sandbox exit for Indian numbers).
SMS_ENABLED=
# 1 enables WhatsApp Cloud API (needs a Meta WhatsApp Business account and approved templates).
WHATSAPP_ENABLED=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Billing (Razorpay Subscriptions). Off unless BILLING_ENABLED=1; then all four values are required.
# The webhook URL to register in the Razorpay dashboard is https://api.muxaris.com/webhooks/razorpay
# with the "subscription.*" events and the secret below.
BILLING_ENABLED=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STANDARD=

# Telephony (off unless TELEPHONY_PROVIDER=twilio). The API verifies Twilio's signature with the
# auth token and mints a 5-minute stream token the gateway verifies before accepting a call.
TELEPHONY_PROVIDER=
TWILIO_AUTH_TOKEN=
TELEPHONY_STREAM_SECRET=
VOICE_WSS_URL=wss://voice.muxaris.com
# Public base URL of the API: Twilio's signature is computed over PUBLIC_API_URL + the webhook path.
PUBLIC_API_URL=http://localhost:4000
