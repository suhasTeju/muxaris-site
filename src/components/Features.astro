---
const features = [
  {
    n: '01',
    title: 'Fallback is a property of the role',
    body: 'Every role declares its backup up front. When the primary times out, errors, or returns an empty body, the fallback answers on the same call — your caller never learns anything went wrong.',
  },
  {
    n: '02',
    title: 'Latency budgets that match the caller',
    body: 'A guardrail running on every user turn cannot share a timeout with a nightly batch job. Interactive roles fail fast on a bounded client; background roles keep the long one.',
  },
  {
    n: '03',
    title: 'Clients are built once',
    body: 'Provider clients are cached by role signature instead of reconstructed per call. Session and connection setup stops showing up in your p99.',
  },
  {
    n: '04',
    title: 'JSON repair instead of lost work',
    body: 'When a model closes an object with the wrong bracket, a cheap repair model reconstructs it and logs a window around the offending character. Only broken replies pay the round trip.',
  },
  {
    n: '05',
    title: 'Every call priced and logged',
    body: 'Tokens, latency, provider, role and cost land in one table per call — rolled up daily and purged on a retention window, so the log never becomes the thing you have to clean up.',
  },
  {
    n: '06',
    title: 'Text, vision and streaming on one path',
    body: 'Image input and token streaming route through the same registry as plain completions. One integration, not three parallel ones that drift apart.',
  },
];
---

<section
  id="features"
  class="scroll-mt-20 border-t border-ink-850 bg-ink-900/30"
>
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <p class="rule-label">02 — What you get</p>
      <h2
        class="mt-4 font-display text-3xl leading-tight font-bold tracking-[-0.02em] text-mist-100 sm:text-[2.5rem]"
      >
        The plumbing you'd write anyway, already written.
      </h2>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-xl bg-ink-800 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <article class="group relative bg-ink-900 p-7 transition-colors hover:bg-ink-850">
            <span class="font-mono text-[11px] tracking-[0.18em] text-signal-600">
              {f.n}
            </span>
            <h3 class="mt-4 font-display text-lg leading-snug font-bold tracking-[-0.01em] text-mist-100">
              {f.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-mist-400">{f.body}</p>
            <span
              aria-hidden="true"
              class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-signal-500 transition-transform duration-500 group-hover:scale-x-100"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
