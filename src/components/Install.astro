---
const steps = [
  {
    n: '1',
    title: 'Install',
    code: 'pip install muxaris',
  },
  {
    n: '2',
    title: 'Point it at a provider',
    code: 'export MUXARIS_PROVIDER=bedrock\nexport AWS_REGION=ap-south-1',
  },
  {
    n: '3',
    title: 'Call a role',
    code: 'from muxaris import chat\n\nchat("reasoning").complete(messages=msgs)',
  },
];
---

<section id="install" class="scroll-mt-20 border-t border-ink-850">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="rule-label">05 — Get started</p>
      <h2
        class="mt-4 font-display text-3xl leading-tight font-bold tracking-[-0.02em] text-mist-100 sm:text-[2.5rem]"
      >
        Self-hosted, MIT, no control plane.
      </h2>
      <p class="mt-5 text-[1.0625rem] leading-relaxed text-mist-400">
        Muxaris is a library, not a service. There is nothing to sign up for and
        no proxy sitting between you and your provider — your keys stay in your
        environment and your traffic never leaves your infrastructure.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        steps.map((s) => (
          <div class="rounded-xl border border-ink-800 bg-ink-900/60 p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-6 w-6 items-center justify-center rounded border border-ink-700 font-mono text-[11px] text-signal-500">
                {s.n}
              </span>
              <h3 class="font-display text-base font-bold text-mist-100">
                {s.title}
              </h3>
            </div>
            <pre class="mt-4 overflow-x-auto rounded-lg border border-ink-800 bg-ink-950 p-4 font-mono text-[12.5px] leading-relaxed text-mist-300"><code>{s.code}</code></pre>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-3">
      <a
        href="https://github.com/suhasTeju/muxaris"
        class="rounded-md bg-signal-500 px-5 py-2.5 font-mono text-sm font-medium text-ink-950 transition-colors hover:bg-signal-400"
      >
        Read the source
      </a>
      <a
        href="#roles"
        class="rounded-md border border-ink-700 px-5 py-2.5 font-mono text-sm text-mist-300 transition-colors hover:border-ink-600 hover:text-mist-100"
      >
        Back to the routing model
      </a>
    </div>
  </div>
</section>
