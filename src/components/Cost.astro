---
// Cost accounting. The sample rows below are illustrative of the schema, not
// a published benchmark — keep it that way.
const rows = [
  { role: 'guardrail', model: 'gpt-oss-20b', tokens: '412 / 96', ms: '380', route: 'primary' },
  { role: 'reasoning', model: 'gpt-oss-120b', tokens: '3,104 / 812', ms: '4,910', route: 'primary' },
  { role: 'structured', model: 'minimax-m2.5', tokens: '1,880 / 640', ms: '7,240', route: 'fallback' },
  { role: 'flagship', model: 'kimi-k2.5', tokens: '9,220 / 3,410', ms: '18,650', route: 'primary' },
];
---

<section
  id="cost"
  class="scroll-mt-20 border-t border-ink-850 bg-ink-900/30"
>
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="rule-label">04 — Accounting</p>
        <h2
          class="mt-4 font-display text-3xl leading-tight font-bold tracking-[-0.02em] text-mist-100 sm:text-[2.5rem]"
        >
          Know which role is spending your money.
        </h2>
        <p class="mt-5 text-[1.0625rem] leading-relaxed text-mist-400">
          A provider invoice tells you what you spent. It won't tell you that
          one guardrail is firing on every turn, or that a role has been quietly
          serving from its fallback for a week. Muxaris writes a row per call —
          role, model, route taken, tokens, latency, cost — then rolls it up
          daily and drops the raw rows on a retention window you set.
        </p>

        <ul class="mt-8 space-y-3">
          {
            [
              'Per-call rows with the route actually taken',
              'Daily rollups so dashboards stay cheap to query',
              'Automatic purge — the log never outgrows the app',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-mist-400">
                <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-signal-500" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="overflow-hidden rounded-xl border border-ink-800 bg-ink-900 shadow-[0_24px_60px_-28px_rgba(0,0,0,0.9)]"
      >
        <div
          class="flex items-center justify-between border-b border-ink-800 bg-ink-850/60 px-5 py-3"
        >
          <span class="font-mono text-[11px] text-mist-400">usage_log</span>
          <span class="rule-label">schema sample</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[520px] text-left">
            <thead>
              <tr class="border-b border-ink-850">
                <th class="rule-label px-5 py-2.5 font-normal">Role</th>
                <th class="rule-label px-5 py-2.5 font-normal">Model</th>
                <th class="rule-label px-5 py-2.5 font-normal">In / Out</th>
                <th class="rule-label px-5 py-2.5 font-normal">ms</th>
                <th class="rule-label px-5 py-2.5 font-normal">Route</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr class="border-b border-ink-850 last:border-0">
                    <td class="px-5 py-3 font-mono text-[12.5px] text-signal-500">
                      {r.role}
                    </td>
                    <td class="px-5 py-3 font-mono text-[12.5px] text-mist-300">
                      {r.model}
                    </td>
                    <td class="px-5 py-3 font-mono text-[12.5px] text-mist-400">
                      {r.tokens}
                    </td>
                    <td class="px-5 py-3 font-mono text-[12.5px] text-mist-400">
                      {r.ms}
                    </td>
                    <td class="px-5 py-3">
                      <span
                        class={`font-mono text-[11px] ${r.route === 'fallback' ? 'text-relay-400' : 'text-mist-500'}`}
                      >
                        {r.route}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="border-t border-ink-800 px-5 py-3">
          <p class="font-mono text-[11px] text-mist-500">
            Illustrative rows showing the shape of the table — not a benchmark.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
