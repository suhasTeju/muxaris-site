---
const links = [
  { label: 'How it works', href: '#roles' },
  { label: 'Features', href: '#features' },
  { label: 'Cost', href: '#cost' },
  { label: 'Docs', href: '#install' },
];
---

<header
  class="sticky top-0 z-50 border-b border-ink-800/70 bg-ink-950/80 backdrop-blur-xl"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a href="/" class="group flex items-center gap-2.5">
      <svg
        width="22"
        height="22"
        viewBox="0 0 22 22"
        fill="none"
        aria-hidden="true"
        class="shrink-0"
      >
        <path
          d="M2 5h4.2L11 11l4.8-6H20"
          stroke="var(--color-signal-500)"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M2 17h4.2L11 11"
          stroke="var(--color-relay-400)"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-dasharray="2.6 2.6"></path>
        <circle cx="11" cy="11" r="2.1" fill="var(--color-signal-500)"></circle>
      </svg>
      <span
        class="font-display text-[15px] font-bold tracking-tight text-mist-100"
        >muxaris</span
      >
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-mist-400 transition-colors hover:text-mist-100"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/suhasTeju/muxaris"
        class="hidden items-center gap-2 rounded-md border border-ink-700 px-3 py-1.5 font-mono text-xs text-mist-300 transition-colors hover:border-ink-600 hover:text-mist-100 sm:flex"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>
      <a
        href="#install"
        class="rounded-md bg-signal-500 px-3.5 py-1.5 font-mono text-xs font-medium text-ink-950 transition-colors hover:bg-signal-400"
      >
        Get started
      </a>
    </div>
  </nav>
</header>
